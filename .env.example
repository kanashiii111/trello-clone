DOCKERHUB_NAMESPACE=your-dockerhub-username
IMAGE_TAG=0.1.0
COMPOSE_PROJECT_NAME=devops-course
NGINX_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
UID=1000
GID=1000

# --- Мониторинг (compose.monitoring.yaml) ---
# Пользователь PostgreSQL для postgres-exporter (роль pg_monitor, без доступа к данным)
POSTGRES_EXPORTER_USER=postgres_exporter
POSTGRES_EXPORTER_PASSWORD=exporter_dev_password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
# Web UI Mailpit — сюда приходят письма алертов
MAILPIT_PORT=8025
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# UI cAdvisor (только при COMPOSE_PROFILES=cadvisor)
CADVISOR_PORT=8088

# --- Логи (compose.logging.yaml) ---
GRAYLOG_PORT=9000
# Порт приёма GELF по UDP: на него Docker daemon шлёт логи контейнеров
GRAYLOG_GELF_PORT=12201
# Секрет для шифрования сессий Graylog, не короче 16 символов
GRAYLOG_PASSWORD_SECRET=devops-course-dev-secret-0123456789
# Пароль admin в Graylog задаётся дважды: открытым текстом (для init-скрипта)
# и SHA-256 (его требует сам Graylog). При смене пароля обновите оба:
#   printf 'новый_пароль' | sha256sum   (на macOS: shasum -a 256)
GRAYLOG_ROOT_PASSWORD=admin
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
