    {
      "type": "timeseries",
      "id": 7,
      "title": "Errors: доля ответов 5xx",
      "description": "Доля, а не количество: 10 ошибок при 10 запросах и при 10 000 — разные ситуации. «or vector(0)» — чтобы при отсутствии ошибок был 0, а не пустой график. Пунктир — порог алерта HighErrorRate (5%).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "softMax": 0.1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(http_requests_total{status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "доля 5xx",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (route) (rate(http_requests_total{status=~\"5..\"}[$__rate_interval])) / ignoring(route) group_left sum(rate(http_requests_total[$__rate_interval]))",
          "legendFormat": "вклад {{route}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "type": "timeseries",
